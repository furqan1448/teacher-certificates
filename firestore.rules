rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // المشروع حاليًا لا يستخدم Firestore لتخزين أي بيانات؛
    // Firebase يُستخدم فقط لتسجيل دخول الإدارة (Authentication).
    // بيانات المعلمات والإحصائيات كلها في Google Sheets.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
