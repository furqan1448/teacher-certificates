rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // رابط "للاطلاع على التفاصيل" في لوحة الإدارة
    // يسمح لأي مستخدم مسجّل دخول (حساب الإدارة) بقراءته وتعديله.
    match /settings/detailsLink {
      allow read, write: if request.auth != null;
    }

    // باقي المشروع لا يستخدم Firestore لتخزين بيانات أخرى؛
    // Firebase يُستخدم أيضًا لتسجيل دخول الإدارة (Authentication).
    // بيانات المعلمات والإحصائيات كلها في Google Sheets.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
